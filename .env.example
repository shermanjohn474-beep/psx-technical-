# ---- Copy to .env and fill in. Never commit .env. ----
# Storage (empty = backend/data and backend/psx_dev.sqlite3)
DATA_DIR=
DATABASE_URL=
# API security (comma-separated keys). Empty = open API (development only!)
APP_API_KEYS=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# AI provider: none | anthropic | openai   (keys stay server-side)
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_TIMEOUT_SECONDS=90

# Authorized market-data feed (optional). No PSX endpoint is assumed; point this at a
# feed you are licensed to use. Placeholders: {symbol} {timeframe} {start} {end}
MARKET_DATA_URL_TEMPLATE=
MARKET_DATA_API_KEY=
MARKET_DATA_PROVIDER_NAME=configured-http-provider
MAX_DATA_STALENESS_DAYS=4

# PSX session (verify against current PSX notices)
PSX_SESSION_CLOSE=15:30
PSX_FRIDAY_SESSION_CLOSE=16:30
PSX_HOLIDAYS_FILE=

# Symbols you have verified as short-sell eligible with your broker (comma-separated)
SHORT_ELIGIBLE_SYMBOLS=

# Alerts
ALERTS_SCHEDULER_ENABLED=false
ALERTS_INTERVAL_SECONDS=900
PUBLIC_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Authorized WhatsApp provider endpoint (e.g. a Business API gateway) — optional
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
